# Variáveis para o serviço `db` do docker-compose.
# Copie este arquivo para .env.docker e preencha com seus valores locais.
#
#   cp .env.docker.example .env.docker
#
# O .env.docker NÃO é versionado (está no .gitignore).

# Usuário do Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financas_db
