# Banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Sem senha (trust): postgresql://postgres@localhost:5432/financas_db
# Com senha:         postgresql://postgres:minhasenha@localhost:5432/financas_db
DATABASE_URL="postgresql://postgres@localhost:5432/financas_db"

# Autenticação
# IMPORTANTE: gere uma chave segura em produção (mínimo 32 caracteres)
# Sugestão: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-uma-chave-segura-de-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001

# BrAPI (opcional) — token para cotações de ativos
# Obtenha gratuitamente em https://brapi.dev
BRAPI_TOKEN=
