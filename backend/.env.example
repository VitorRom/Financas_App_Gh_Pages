# Banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Local (Postgres rodando na máquina): postgresql://postgres:SUA_SENHA@localhost:5432/financas_db
# Docker compose:                       postgresql://postgres:SUA_SENHA@db:5432/financas_db
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/financas_db"

# Autenticação
# IMPORTANTE: gere uma chave segura (mínimo 32 caracteres).
# Sugestão: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-uma-chave-segura-de-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=development

# CORS — em produção, defina a URL do frontend.
# Aceita múltiplas origens separadas por vírgula.
# Vazio = aceita qualquer origem (apenas dev).
CORS_ORIGIN=http://localhost:5173

# BrAPI (opcional) — token para cotações de ativos
# Obtenha gratuitamente em https://brapi.dev
BRAPI_TOKEN=
